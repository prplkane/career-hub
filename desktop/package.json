{
  "name": "career-hub-desktop-host",
  "productName": "Career Hub Dev",
  "version": "0.0.0",
  "private": true,
  "author": "Career Hub Contributors",
  "description": "Locked-down Electron host for the local Career Hub application.",
  "main": "src/main.js",
  "scripts": {
    "build:go-sidecar": "node scripts/build-go-sidecar.cjs",
    "start": "electron-forge start",
    "package": "node scripts/prepare-package.cjs dev && electron-forge package",
    "package:stable": "node scripts/prepare-package.cjs stable && electron-forge package",
    "make:windows:dev": "node scripts/prepare-package.cjs dev && electron-forge make --platform=win32 --arch=x64",
    "package:windows:go-preview": "node scripts/prepare-package.cjs dev --go-preview && electron-forge package --platform=win32 --arch=x64",
    "make:windows:go-preview": "node scripts/prepare-package.cjs dev --go-preview && electron-forge make --platform=win32 --arch=x64",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-foundation.cjs",
    "qualify:go-sidecar": "node scripts/qualify-go-sidecar.cjs"
  },
  "engines": {
    "node": "24.19.0"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "$extract-zip",
    "http-cache-semantics": "4.3.0",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  }
}
